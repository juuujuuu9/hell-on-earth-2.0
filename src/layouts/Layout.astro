---
import '../styles/global.css';
import CartIcon from '@components/CartIcon';

interface Props {
  title: string;
  hideHeader?: boolean;
}

const { title, hideHeader = false } = Astro.props;

const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- RULE-004: Font imports -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Mega:wght@400&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.typekit.net/rox0jfu.css" />
    <title>{title}</title>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="2e3023b6-505a-48d2-b491-0225b61304e4"></script>
    {posthogKey && (
      <script define:vars={{ posthogKey, posthogHost }} is:inline>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.getElementsByTagName("script")[0];e.parentNode.insertBefore(t,o)}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=g;e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(posthogKey,{api_host:posthogHost});
      </script>
    )}
  </head>
  <body>
    {!hideHeader && (
      <header class="fixed top-0 left-0 right-0 z-50 p-4 flex items-center justify-between">
        <nav class="flex items-center gap-6">
          <a href="/" class="text-white hover:text-gray-300 transition-colors font-semibold cursor-pointer">
            Home
          </a>
          <a href="/products" class="text-white hover:text-gray-300 transition-colors font-semibold cursor-pointer">
            Products
          </a>
          <a href="/contact" class="text-white hover:text-gray-300 transition-colors font-semibold cursor-pointer">
            Contact
          </a>
        </nav>
        <div>
          <CartIcon client:load />
        </div>
      </header>
    )}
    <slot />
  </body>
</html>
