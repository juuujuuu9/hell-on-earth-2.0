---
---

<footer class="max-w-[1920px] mx-auto px-4 lg:px-8 pb-16 pt-8">
  <!-- Mailing List Section -->
  <div class="pb-12">
    <div class="text-center">
      <h2 class="text-lg uppercase font-bold mb-2">JOIN OUR MAILING LIST</h2>
      <p class="text-sm mb-6">Enter your email to be notified of upcoming releases.</p>
      
      <form
        id="footer-mailing-list-form"
        class="max-w-md mx-auto space-y-4"
        method="post"
        action="#"
        novalidate
      >
        <input
          type="email"
          name="email"
          placeholder="Email Address *"
          required
          class="w-full px-4 py-2 border border-black bg-white text-center focus:outline-none"
          aria-label="Email Address"
        />
        <p id="footer-subscribe-success" class="hidden text-sm text-green-600 text-center" role="status"></p>
        <p id="footer-subscribe-error" class="hidden text-sm text-red-600 text-center" role="alert"></p>
        <button
          type="submit"
          id="footer-subscribe-btn"
          class="w-full px-4 py-2 bg-black text-white uppercase font-bold hover:opacity-70 transition-opacity cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
        >
          SUBSCRIBE
        </button>
      </form>
      <script>
        (function () {
          const form = document.getElementById('footer-mailing-list-form') as HTMLFormElement;
          const successEl = document.getElementById('footer-subscribe-success');
          const errorEl = document.getElementById('footer-subscribe-error');
          const btn = document.getElementById('footer-subscribe-btn') as HTMLButtonElement;
          if (!form || !btn) return;

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            successEl?.classList.add('hidden');
            errorEl?.classList.add('hidden');
            const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value?.trim();
            if (!email) {
              if (errorEl) { errorEl.textContent = 'Please enter your email.'; errorEl.classList.remove('hidden'); }
              return;
            }
            btn.disabled = true;
            btn.textContent = 'Submitting...';
            try {
              const res = await fetch('/api/mailing-list', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, source: 'footer' }),
              });
              const result = await res.json();
              if (result.success) {
                if (successEl) { successEl.textContent = result.message ?? 'Thanks for subscribing.'; successEl.classList.remove('hidden'); }
                form.reset();
              } else {
                if (errorEl) { errorEl.textContent = result.error ?? 'Something went wrong.'; errorEl.classList.remove('hidden'); }
              }
            } catch {
              if (errorEl) { errorEl.textContent = 'Something went wrong. Please try again.'; errorEl.classList.remove('hidden'); }
            } finally {
              btn.disabled = false;
              btn.textContent = 'SUBSCRIBE';
            }
          });
        })();
      </script>
    </div>
  </div>
  <!-- Full-width border -->
  <div class="border-b border-gray-200 -mx-4 lg:-mx-8 mb-12"></div>
  
  <!-- Logo, Social, Info Section -->
  <div class="flex flex-col lg:grid lg:grid-cols-3 items-center gap-8 text-gray-500">
    <!-- Left: Instagram Icon -->
    <div class="flex justify-center lg:justify-start">
      <a 
        href="https://instagram.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-gray-500 hover:opacity-70 transition-opacity cursor-pointer"
        aria-label="Instagram"
      >
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.5" 
          stroke-linecap="round" 
          stroke-linejoin="round"
          class="w-9 h-9"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
    </div>
    
    <!-- Center: Logo and E-Commerce Info -->
    <div class="text-center">
      <div class="mb-2">
        <img 
          src="/hell-grey.png" 
          alt="hell" 
          class="h-20 mx-auto object-contain"
        />
      </div>
      <p class="text-xs text-gray-500">
        E-Commerce by <a href="https://www.instagram.com/thoughtform_/" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70 transition-opacity">THOUGHTFORM WORLDWIDE</a>
      </p>
    </div>
    
    <!-- Right: Terms and Copyright -->
    <div class="text-center lg:text-right text-gray-500">
      <p class="text-sm uppercase font-bold mb-2">TERMS OF USE & CONTACT INFO</p>
      <p class="text-xs">©2026 HELL ON EARTH MFG.</p>
    </div>
  </div>
</footer>
