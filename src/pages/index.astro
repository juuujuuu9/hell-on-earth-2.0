---
import Layout from '@layouts/Layout.astro';
---
<Layout title="Home" hideHeader={true}>
    <main class="fixed inset-0 w-screen h-screen p-0 m-0 overflow-hidden">
      <video 
        id="background-video"
        class="absolute top-0 left-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
      >
        <source id="video-source-mp4" src="" type="video/mp4" />
        <source id="video-source-webm" src="" type="video/webm" />
      </video>
      <div class="absolute inset-0 flex flex-col items-center justify-center z-20 overflow-y-auto py-8 px-4">
        <div class="max-w-[650px] w-full mb-8" style="aspect-ratio: 1080 / 581;">
          <img 
            src="/3d-logo-hero.webp" 
            alt="HOE" 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        
        <div class="text-center mb-4">
          <p class="text-xl text-white">SUBSCRIBE TO OUR MAILINGLIST<br>FOR UPDATES</p>
        </div>

        <div class="subscription-wrapper max-w-md w-full px-4">
          <style is:inline>
            .subscription-wrapper form { padding: 20px; width: 100%; text-align: left; }
            .subscription-wrapper .sub-field { margin-bottom: 20px; }
            .subscription-wrapper .sub-input { font-weight: bold; text-transform: uppercase; width: 100%; box-sizing: border-box; padding: 10px; background-color: hsla(0, 0%, 45%, 0.592); color: #00FF00; text-align: center; border: none; border-radius: 0.5rem; }
            .subscription-wrapper .sub-submit { background-color: #000; color: #fff; font-weight: bold; width: 100%; padding: 10px; border: none; text-align: center; cursor: pointer; transition: opacity 0.3s ease; border-radius: 0.5rem; }
            .subscription-wrapper .sub-submit:disabled { opacity: 0.6; cursor: not-allowed; }
            .subscription-wrapper .sub-loading { display: none; text-align: center; margin-top: 10px; }
            .subscription-wrapper .sub-loading span { display: inline-block; width: 8px; height: 8px; background: #00FF00; border-radius: 50%; margin: 0 3px; animation: sub-bounce 1.4s infinite ease-in-out both; }
            .subscription-wrapper .sub-loading span:nth-child(1) { animation-delay: -0.32s; }
            .subscription-wrapper .sub-loading span:nth-child(2) { animation-delay: -0.16s; }
            @keyframes sub-bounce { 0%, 80%, 100% { transform: scale(0); opacity: 0.5; } 40% { transform: scale(1); opacity: 1; } }
            .subscription-wrapper .sub-success { display: none; color: #00FF00; text-align: center; margin-top: 10px; }
            .subscription-wrapper .sub-error { display: none; color: #ff0000; text-align: center; margin-top: 10px; }
          </style>
          <form id="subscription-form" class="subscription-form" novalidate>
            <div class="sub-field">
              <input type="email" name="email" id="subscription-email" autocomplete="email" placeholder="Email Address *" required aria-label="Email Address" class="sub-input" />
            </div>
            <div class="sub-field">
              <input type="submit" class="sub-submit" value="SUBSCRIBE" id="subscription-submit" />
              <div class="sub-loading" id="subscription-loading" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
            </div>
            <p class="sub-success" id="subscription-success">Thanks for subscribing. Check your inbox for updates.</p>
            <p class="sub-error" id="subscription-error" role="alert"></p>
          </form>
        </div>
      </div>
    </main>
</Layout>

<script>
  // List of videos in the creep playlist (MP4 for Safari/iOS, WebM for others)
  const videos = [
    { mp4: '/videos/creep/Blank Room Soup 2.mp4', webm: '/videos/creep/Blank Room Soup 2.webm' },
    { mp4: '/videos/creep/Blank Room Soup 3.mp4', webm: '/videos/creep/Blank Room Soup 3.webm' },
    { mp4: '/videos/creep/Blank Room Soup 4.mp4', webm: '/videos/creep/Blank Room Soup 4.webm' },
    { mp4: '/videos/creep/Blank Room Soup 5.mp4', webm: '/videos/creep/Blank Room Soup 5.webm' },
    { mp4: '/videos/creep/Blank Room Soup.avi.mp4', webm: '/videos/creep/Blank Room Soup.avi.webm' },
    { mp4: '/videos/creep/Dining Room or There is Nothing.mp4', webm: '/videos/creep/Dining Room or There is Nothing.webm' },
    { mp4: '/videos/creep/full stop punctuation  .    ø.mp4', webm: '/videos/creep/full stop punctuation  .    ø.webm' },
    { mp4: '/videos/creep/Illusion of Bias.mp4', webm: '/videos/creep/Illusion of Bias.webm' },
    { mp4: '/videos/creep/Take Care.mp4', webm: '/videos/creep/Take Care.webm' },
  ];

  const randomVideo = videos[Math.floor(Math.random() * videos.length)];
  const video = document.getElementById('background-video') as HTMLVideoElement;
  const sourceMp4 = document.getElementById('video-source-mp4') as HTMLSourceElement;
  const sourceWebm = document.getElementById('video-source-webm') as HTMLSourceElement;

  if (video && sourceMp4 && sourceWebm) {
    sourceMp4.src = randomVideo.mp4;
    sourceWebm.src = randomVideo.webm;
    video.load();
    video.play().catch((error) => {
      console.error('Error playing video:', error);
    });
  }

  const subscriptionForm = document.getElementById('subscription-form') as HTMLFormElement;
  const successMessage = document.getElementById('subscription-success') as HTMLElement;
  const errorMessage = document.getElementById('subscription-error') as HTMLElement;
  const submitButton = document.getElementById('subscription-submit') as HTMLInputElement;
  const loadingIndicator = document.getElementById('subscription-loading') as HTMLElement;

  if (subscriptionForm) {
    subscriptionForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (successMessage) successMessage.style.display = 'none';
      if (errorMessage) errorMessage.style.display = 'none';
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.value = 'SUBMITTING...';
      }
      if (loadingIndicator) {
        loadingIndicator.style.display = 'block';
        loadingIndicator.setAttribute('aria-hidden', 'false');
      }

      const email = (subscriptionForm.querySelector('input[name="email"]') as HTMLInputElement)?.value?.trim();
      if (!email) {
        if (errorMessage) {
          errorMessage.textContent = 'Please enter your email.';
          errorMessage.style.display = 'block';
        }
        if (submitButton) { submitButton.disabled = false; submitButton.value = 'SUBSCRIBE'; }
        if (loadingIndicator) { loadingIndicator.style.display = 'none'; loadingIndicator.setAttribute('aria-hidden', 'true'); }
        return;
      }

      try {
        const response = await fetch('/api/mailing-list', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'index' }),
        });
        const result = await response.json();

        if (result.success) {
          if (successMessage) {
            successMessage.textContent = result.message ?? 'Thanks for subscribing. Check your inbox for updates.';
            successMessage.style.display = 'block';
          }
          subscriptionForm.reset();
        } else {
          if (errorMessage) {
            errorMessage.textContent = result.error ?? 'Something went wrong. Please try again.';
            errorMessage.style.display = 'block';
          }
        }
      } catch (err) {
        console.error('Subscription error:', err);
        if (errorMessage) {
          errorMessage.textContent = 'Something went wrong. Please try again.';
          errorMessage.style.display = 'block';
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.value = 'SUBSCRIBE';
        }
        if (loadingIndicator) {
          loadingIndicator.style.display = 'none';
          loadingIndicator.setAttribute('aria-hidden', 'true');
        }
      }
    });
  }
</script>

<style>
  body {
    margin: 0;
    padding: 0;
  }
  
  html {
    overflow: hidden;
  }
  
  #background-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
