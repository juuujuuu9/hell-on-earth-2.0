---
import PostHogLayout from '../layouts/PostHogLayout.astro';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
---

<PostHogLayout>
  <Layout title="Terms of Service" hideHeader={true}>
    <main class="min-h-screen bg-white">
      <Header />

      <div class="max-w-[1920px] mx-auto px-4 lg:px-8 py-12 lg:py-16">
        <article class="max-w-3xl mx-auto text-black">
          <h1 class="text-3xl lg:text-4xl font-bold uppercase mb-8">Terms of Service</h1>

          <div class="prose prose-black space-y-8">
            <section>
              <h2 class="text-xl font-bold uppercase mb-4">1. Agreement</h2>
              <p class="text-gray-700">
                By accessing and using this website, you accept and agree to be bound by these Terms of Service.
                If you do not agree, please do not use this site.
              </p>
            </section>

            <section>
              <h2 class="text-xl font-bold uppercase mb-4">2. Use of Site</h2>
              <p class="text-gray-700">
                You may use this site only for lawful purposes. You may not use this site in any way that
                violates applicable laws or that could damage, disable, or impair the site or any connected systems.
              </p>
            </section>

            <section>
              <h2 class="text-xl font-bold uppercase mb-4">3. Orders & Payment</h2>
              <p class="text-gray-700">
                All orders are subject to availability. We reserve the right to refuse or cancel orders.
                Prices are as displayed at the time of order. Payment is due at checkout.
              </p>
            </section>

            <section>
              <h2 class="text-xl font-bold uppercase mb-4">4. Shipping & Returns</h2>
              <p class="text-gray-700">
                Shipping terms and return policies are as stated at checkout and in your order confirmation.
                Contact us if you have questions about a specific order.
              </p>
            </section>

            <section>
              <h2 class="text-xl font-bold uppercase mb-4">5. Intellectual Property</h2>
              <p class="text-gray-700">
                All content on this site, including text, images, logos, and designs, is the property of
                HELL ON EARTH or its licensors and is protected by copyright and other intellectual property laws.
              </p>
            </section>

            <section>
              <h2 class="text-xl font-bold uppercase mb-4">6. Changes</h2>
              <p class="text-gray-700">
                We may update these terms from time to time. Continued use of the site after changes
                constitutes acceptance of the revised terms.
              </p>
            </section>

            <section>
              <h2 class="text-xl font-bold uppercase mb-4">7. Contact</h2>
              <p class="text-gray-700">
                For questions about these terms, please <a href="/contact" class="underline hover:opacity-70">contact us</a>.
              </p>
            </section>
          </div>
        </article>
      </div>

      <Footer />
    </main>
  </Layout>
</PostHogLayout>